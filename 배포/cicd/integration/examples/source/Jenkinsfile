pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  securityContext:
    fsGroup: 1000
  containers:
    - name: git
      image: alpine/git:latest
      command: [cat]
      tty: true
      resources:
        requests:
          cpu: 50m
          memory: 64Mi
    - name: python
      image: python:3.12.12-alpine3.22
      command: [cat]
      tty: true
      resources:
        requests:
          cpu: 100m
          memory: 128Mi
'''
    }
  }
  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timeout(time: 20, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  stages {
    stage('Checkout') {
      steps {
        container('git') {
          script {
            def result = checkout scm
            env.CICD_REVISION = result.GIT_COMMIT
          }
        }
      }
    }
    stage('CI validation') {
      steps {
        container('python') {
          sh 'python -m unittest discover -v'
        }
      }
    }
    stage('Publish verified revision') {
      steps {
        container('python') {
          withCredentials([string(credentialsId: params.CICD_GITOPS_CREDENTIAL, variable: 'GITOPS_TOKEN')]) {
            withEnv([
              'CICD_API=' + params.CICD_GITLAB_API,
              'CICD_PROJECT=' + params.CICD_GITOPS_PROJECT_ID,
              'CICD_BRANCH=' + params.CICD_GITOPS_BRANCH,
              'CICD_PATH=' + params.CICD_MANIFEST_PATH
            ]) {
              sh 'python publish.py'
            }
          }
        }
      }
    }
  }
}
