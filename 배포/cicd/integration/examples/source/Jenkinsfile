pipeline {
  agent {
    kubernetes {
      yaml '''
apiVersion: v1
kind: Pod
spec:
  securityContext:
    fsGroup: 1000
  containers:
    - name: git
      image: alpine/git:2.47.2
      command: [cat]
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      resources:
        requests: {cpu: 50m, memory: 64Mi}
    - name: python
      image: python:3.12.12-alpine3.22
      command: [cat]
      tty: true
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
      resources:
        requests: {cpu: 100m, memory: 128Mi}
    - name: buildkit
      image: moby/buildkit:v0.25.2-rootless
      command: [cat]
      tty: true
      env:
        - name: BUILDKITD_FLAGS
          value: --oci-worker-no-process-sandbox
      securityContext:
        runAsUser: 1000
        runAsGroup: 1000
        seccompProfile: {type: Unconfined}
        appArmorProfile: {type: Unconfined}
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {cpu: '2', memory: 2Gi}
      volumeMounts:
        - name: buildkit-state
          mountPath: /home/user/.local/share/buildkit
  volumes:
    - name: buildkit-state
      emptyDir: {}
'''
    }
  }
  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  stages {
    stage('Checkout') {
      steps {
        container('git') {
          script {
            def result = checkout scm
            env.CICD_REVISION = result.GIT_COMMIT
            env.CICD_IMAGE = params.CICD_REGISTRY + '/' + params.CICD_IMAGE_REPOSITORY
          }
        }
      }
    }
    stage('Test') {
      steps {
        container('python') {
          sh params.CICD_TEST_COMMAND
        }
      }
    }
    stage('Build and push image') {
      steps {
        script {
          def configPath = pwd(tmp: true) + '/registry-' + env.BUILD_NUMBER
          withEnv(['DOCKER_CONFIG=' + configPath, 'CICD_REGISTRY_HOST=' + params.CICD_REGISTRY,
                   'CICD_CONTEXT=' + params.CICD_BUILD_CONTEXT, 'CICD_DOCKERFILE=' + params.CICD_DOCKERFILE]) {
            withCredentials([usernamePassword(credentialsId: params.CICD_REGISTRY_CREDENTIAL,
                              usernameVariable: 'REGISTRY_USER', passwordVariable: 'REGISTRY_PASSWORD')]) {
              try {
                container('python') {
                  sh '''set +x
python - <<'PY'
import base64, json, os
from pathlib import Path
p = Path(os.environ['DOCKER_CONFIG'])
p.mkdir(parents=True, exist_ok=True, mode=0o700)
auth = base64.b64encode((os.environ['REGISTRY_USER'] + ':' + os.environ['REGISTRY_PASSWORD']).encode()).decode()
f = p / 'config.json'
f.write_text(json.dumps({'auths': {os.environ['CICD_REGISTRY_HOST']: {'auth': auth}}}))
f.chmod(0o600)
PY
'''
                }
                container('buildkit') {
                  sh '''set +x
buildctl-daemonless.sh build --frontend dockerfile.v0 \
  --local "context=$WORKSPACE/$CICD_CONTEXT" \
  --local "dockerfile=$WORKSPACE" \
  --opt "filename=$CICD_DOCKERFILE" \
  --output "type=image,name=$CICD_IMAGE:$CICD_REVISION,push=true"
'''
                }
              } finally {
                container('python') {
                  sh 'rm -rf -- "$DOCKER_CONFIG"'
                }
              }
            }
          }
        }
      }
    }
    stage('Update deployment repository') {
      steps {
        container('python') {
          withCredentials([string(credentialsId: params.CICD_GITOPS_CREDENTIAL, variable: 'GITOPS_TOKEN')]) {
            withEnv([
              'CICD_API=' + params.CICD_GITLAB_API,
              'CICD_PROJECT=' + params.CICD_GITOPS_PROJECT_ID,
              'CICD_BRANCH=' + params.CICD_GITOPS_BRANCH,
              'CICD_PATH=' + params.CICD_MANIFEST_PATH,
              'PYTHONPATH=/tmp/cicd-python'
            ]) {
              sh 'python -m pip install --quiet --target /tmp/cicd-python PyYAML==6.0.3'
              sh 'python publish.py'
            }
          }
        }
      }
    }
  }
}
