# Loki chart 19.0.2: single-binary + S3 + persistent local WAL/cache.
# Environment variables are required; see environments/README.md.
deploymentMode: SingleBinary

loki:
  auth_enabled: false
  commonConfig:
    replication_factor: 1
  schemaConfig:
    configs:
      - from: "2024-01-01"
        store: tsdb
        object_store: s3
        schema: v13
        index:
          prefix: loki_index_
          period: 24h
  storage:
    type: s3
    bucketNames:
      chunks: {{ requiredEnv "S3_BUCKET" | quote }}
      ruler: {{ requiredEnv "S3_BUCKET" | quote }}
      admin: {{ requiredEnv "S3_BUCKET" | quote }}
    s3:
      endpoint: {{ requiredEnv "S3_ENDPOINT" | quote }}
      region: {{ requiredEnv "S3_REGION" | quote }}
      s3ForcePathStyle: true
      insecure: false

singleBinary:
  replicas: 1
  extraEnvFrom:
    - secretRef:
        name: loki-s3-credentials
  persistence:
    enabled: true
    size: 10Gi
    storageClass: {{ requiredEnv "LOKI_STORAGE_CLASS" | quote }}
  # Root initContainer fixes volume ownership for Loki's /var/loki WAL/cache/rules.
  # Check Pod Security Admission policy before enabling on restricted clusters.
  initContainers:
    - name: prepare-loki-data
      image: busybox:1.36
      command: ["sh", "-c", "mkdir -p /var/loki/rules /var/loki/tsdb-shipper-cache && chown -R 10001:10001 /var/loki"]
      securityContext:
        runAsUser: 0
      volumeMounts:
        - name: storage
          mountPath: /var/loki

# Do not deploy distributed components in SingleBinary mode.
read:
  replicas: 0
write:
  replicas: 0
backend:
  replicas: 0
