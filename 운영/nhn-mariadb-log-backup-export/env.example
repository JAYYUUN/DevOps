# NHN Cloud 공공 KR1 RDS 관리 API 주소
RDS_API_URL="https://kr1-rds-mariadb.api.gov-nhncloudservice.com"

# 대상 DB 인스턴스 UUID 및 RDS Appkey
RDS_DB_INSTANCE_ID="YOUR_DB_INSTANCE_UUID"
RDS_APP_KEY="YOUR_RDS_APPKEY"

# RDS API용 토큰 발급에 사용하는 키
RDS_USER_ACCESS_KEY_ID="YOUR_USER_ACCESS_KEY_ID"
RDS_SECRET_ACCESS_KEY="YOUR_SECRET_ACCESS_KEY"

# Object Storage 인증정보
OBJ_TENANT_ID="YOUR_OBJECT_STORAGE_TENANT_ID"
OBJ_USERNAME="YOUR_NHN_CLOUD_OR_IAM_ACCOUNT_ID"
OBJ_PASSWORD="YOUR_OBJECT_STORAGE_API_PASSWORD"

# 기존 컨테이너 이름과 컨테이너 내부 저장 경로
# 날짜(YYYY/MM/DD)는 스크립트가 자동으로 붙인다.
OBJ_CONTAINER="log"
OBJ_BACKUP_PREFIX="db_log_backup"
